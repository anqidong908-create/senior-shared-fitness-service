# No API key is required. The model runs in local Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=180
OLLAMA_RETRIES=2
MAX_HISTORY_MESSAGES=8
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=1000
DEVICE_DATA_MODE=simulator
APP_ENV=demo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET=change-this-before-sharing
DEMO_LOGIN_KEY=local-demo-login
SESSION_DB_PATH=./shared_fitness.sqlite3
